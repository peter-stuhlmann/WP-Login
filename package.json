{
  "name": "portier",
  "version": "1.0.0",
  "private": true,
  "description": "Modern, accessible custom login for WordPress.",
  "license": "GPL-2.0-or-later",
  "author": "Peter R. Stuhlmann (https://peter-stuhlmann-webentwicklung.de)",
  "homepage": "https://github.com/peter-stuhlmann/WP-Login",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peter-stuhlmann/WP-Login.git"
  },
  "bugs": "https://github.com/peter-stuhlmann/WP-Login/issues",
  "scripts": {
    "build": "wp-scripts build admin=./assets/src/admin/index.js frontend=./assets/src/frontend/index.js profile=./assets/src/profile/index.js --output-path=build",
    "start": "wp-scripts start admin=./assets/src/admin/index.js frontend=./assets/src/frontend/index.js profile=./assets/src/profile/index.js --output-path=build",
    "lint:js": "wp-scripts lint-js assets/src tests/js tests/e2e",
    "lint:css": "wp-scripts lint-style \"assets/src/**/*.css\"",
    "test:js": "vitest run",
    "test:e2e": "playwright test",
    "fonts": "node bin/copy-fonts.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@wordpress/api-fetch": "*",
    "@wordpress/components": "*",
    "@wordpress/element": "*",
    "@wordpress/i18n": "*",
    "@wordpress/scripts": "*",
    "geist": "^1.3.0",
    "jsdom": "^25.0.0",
    "qrcode-generator": "^1.5.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "js-beautify": "2.0.3"
  }
}

<?xml version="1.0"?>
<ruleset name="Portier">
    <description>PSR-12 code style plus the WordPress security, escaping and i18n rules.</description>

    <file>portier.php</file>
    <file>uninstall.php</file>
    <file>src</file>
    <file>templates</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12">
        <!-- Templates mix PHP and HTML. -->
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>portier.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <!-- SVG path data. -->
        <exclude-pattern>src/Frontend/Icons.php</exclude-pattern>
        <properties>
            <property name="lineLimit" value="180"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- Security: escaping, nonce/CSRF, sanitising input, safe redirects. -->
    <rule ref="WordPress.Security">
        <!-- Exception messages are never shown: screens map OAuthException::$reason to translated
             texts; technical details only reach the portier_social_login_failed hook (logging). -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="portier"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="portier"/>
                <element value="Portier"/>
            </property>
        </properties>
    </rule>

    <config name="minimum_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
